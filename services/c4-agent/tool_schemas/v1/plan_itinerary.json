{
  "name": "plan_itinerary",
  "description": "Multi-day itinerary from the selected hotel with restaurants along the route",
  "parameters": {
    "type": "object",
    "properties": {
      "hotel_id": {
        "type": "string",
        "minLength": 1,
        "description": "Selected hotel_id returned by recommend_hotels"
      },
      "days": {
        "type": "integer",
        "minimum": 1
      },
      "daily_hours": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 24
      },
      "interests": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "include_restaurants": {
        "type": "boolean"
      },
      "cuisine": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "hotel_id",
      "days",
      "daily_hours",
      "interests",
      "include_restaurants"
    ],
    "additionalProperties": false
  },
  "returns": {
    "type": "object",
    "properties": {
      "days": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "stops": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "attraction_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "arrival_time": {
                    "type": "string",
                    "minLength": 1
                  },
                  "departure_time": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "attraction_id",
                  "name",
                  "latitude",
                  "longitude",
                  "arrival_time",
                  "departure_time"
                ],
                "additionalProperties": false
              }
            },
            "route": {
              "type": "object",
              "properties": {
                "distance_km": {
                  "type": "number",
                  "minimum": 0
                },
                "travel_minutes": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "distance_km",
                "travel_minutes"
              ],
              "additionalProperties": false
            },
            "restaurants": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "restaurant_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cuisine": {
                    "type": "string",
                    "minLength": 1
                  },
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "detour_minutes": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "restaurant_id",
                  "name",
                  "cuisine",
                  "latitude",
                  "longitude",
                  "detour_minutes"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "stops",
            "route",
            "restaurants"
          ],
          "additionalProperties": false
        }
      },
      "map_url": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "days",
      "map_url"
    ],
    "additionalProperties": false
  }
}
