LLM_API_KEY=
LLM_MODEL=

# Where C4 reaches the other components (these defaults work with docker compose)
C1_URL=http://c1-review-engine:8001
C2_URL=http://c2-hotel-recommender:8002
C3_URL=http://c3-itinerary-planner:8003

# Shared database (agree on PostgreSQL or MongoDB as a group)
DATABASE_URL=
